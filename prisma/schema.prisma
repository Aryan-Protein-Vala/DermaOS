// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// NextAuth Models
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// DermaOS Models
model User {
  id                 String    @id @default(cuid())
  email              String    @unique
  emailVerified      DateTime?
  name               String?
  image              String?
  passwordHash       String?
  subscriptionStatus String    @default("free") // free | active | trial
  scanCredits        Int       @default(0)      // One-time scan credits
  
  // Skin profile data
  skinProfile        Json?     // Full analysis result from AI
  skinType           String?   // Oily, Dry, Combination, Normal
  sensitivity        String?   // Low, Medium, High
  concerns           String[]  // Acne, Texture, Hyperpigmentation, etc.
  
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  accounts Account[]
  sessions Session[]
}

model Product {
  id               String   @id @default(cuid())
  name             String
  brand            String
  category         String   // cleanser, moisturizer, serum, sunscreen, etc.
  image            String
  ingredientsIncis String[] // Array of ingredient names
  affiliateUrl     String?  // External product link

  // Multi-region pricing
  priceInr Float?
  priceUsd Float?
  regions  String[] @default(["IN", "GLOBAL"]) // Where product is available

  // RAG matching fields
  skinTypes String[] @default([]) // ["Dry", "Oily", "Normal", "Combination", "Sensitive"]
  concerns  String[] @default([]) // ["Acne", "Hydration", "Pigmentation", "Pores", etc.]
  region    String   @default("GLOBAL") // "IN" or "GLOBAL"

  // Grading data - { oily_acne: { score, reason }, dry_sensitive: {...} }
  globalSuitability Json?

  createdAt DateTime @default(now())
}
